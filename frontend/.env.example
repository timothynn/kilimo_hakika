# The FastAPI verdict engine (backend/). The Next app delegates every verdict
# to it and computes none locally, so /check cannot answer without it running.
#   cd backend && uvicorn main:app --reload --port 8000
KILIMO_TRIAGE_API_URL=http://127.0.0.1:8000

# Depot officer console — shared passphrase gate.
# No defaults on purpose: the app fails closed if these are unset rather than
# shipping an unlocked console. See CLAUDE.md, "Data protection".

# The passphrase depot officers type to reach /depot.
ADMIN_PASSPHRASE=

# Signs the officer session cookie. Any long random string.
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Peppers the SHA-256 of national IDs before storage. A bare hash of a 7-9
# digit number is brute-forceable in seconds, so this is what makes the stored
# hash meaningful. Changing it makes every existing farmer unfindable.
#   openssl rand -base64 32
NATIONAL_ID_HASH_SECRET=

# Optional overrides. Both default to ../database relative to frontend/.
# SCHEME_RULES_PATH=../database/scheme_rules.json
# DATABASE_DIR=../database

# Farmer accounts. Signs the farmer session cookie.
#   openssl rand -base64 32
FARMER_SESSION_SECRET=
