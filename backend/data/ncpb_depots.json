  "custodian": "National Cereals and Produce Board (NCPB)",
  "effective_from": "2026-01-15",
  "notice": "Only gazetted Government (NCPB) depots are listed. This is not a marketplace and contains no private, third-party or vendor outlets.",
  "status_definitions": {
    "ACTIVE": {
      "serves_farmers": true,
      "label": "Open and issuing subsidised fertilizer",
      "description": "Depot is gazetted, staffed and holding subsidy stock. Farmers with complete documentation will be served."
    },
    "STOCK_DEPLETED": {
      "serves_farmers": false,
      "label": "Open but subsidy stock exhausted",
      "description": "Depot is staffed but has no subsidy stock on hand. Farmers will be turned away until the next NCPB replenishment consignment."
    },
    "UNDER_MAINTENANCE": {
      "serves_farmers": false,
      "label": "Temporarily closed for works",
      "description": "Depot is closed for store rehabilitation. Collections are redirected to the nearest active depot in the catchment."
    },
    "SUSPENDED": {
      "serves_farmers": false,
      "label": "Issuance suspended by NCPB",
      "description": "Subsidy issuance is suspended at this depot pending an NCPB administrative review. No collections are possible."
    }
  },
