# Backend
APP_ENV=development
LOG_LEVEL=INFO
API_ALLOWED_ORIGINS=http://localhost:5173

# Active scheme the API serves
SCHEME_CODE=NFSP

# Supabase Postgres. Use the Supavisor transaction-mode connection string.
# psycopg 3 must run with prepare_threshold=None behind a transaction pooler.
DATABASE_URL=postgresql://kh_backend:CHANGE_ME@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Pack loading
PACK_REFRESH_SECONDS=300
# Boot from database/scheme_rules.json when the database is unreachable.
PACK_ALLOW_BUNDLED_FALLBACK=true

# Audit log
TRIAGE_LOG_ENABLED=true
TRIAGE_LOG_RETENTION_DAYS=90
